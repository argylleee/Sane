{
  "name": "appbuilder-hackathon",
  "version": "0.0.0",
  "private": true,
  "description": "Sane: private on-device scam message checker (web PWA)",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "format": "prettier --write .",
    "format:files": "prettier --write --ignore-unknown",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/lint-markdown.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:task": "node scripts/check-task.mjs",
    "task:land": "node scripts/land-task.mjs",
    "task:start": "node scripts/start-task.mjs",
    "check:git": "node scripts/check-git.mjs",
    "role:session": "node scripts/role-session.mjs",
    "role:worktree": "node scripts/role-worktree.mjs",
    "test:tooling": "node --test scripts/tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "vendor:record": "node scripts/record-vendor.mjs",
    "skills:export": "node scripts/export-skills.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:app": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "markdownlint": "0.41.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "0.19.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "3.2.6",
    "@huggingface/transformers": "4.3.1",
    "@mlc-ai/web-llm": "0.2.85",
    "@tailwindcss/vite": "4.3.3",
    "lucide-react": "1.54.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tesseract.js": "7.0.0"
  }
}
